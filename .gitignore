# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# Claude Code — share the project config, ignore machine-specific state.
# `.claude/*` (not `.claude/`) so the negations below can re-include entries;
# git will not descend into a directory that is itself excluded.
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/commands/
.claude/settings.local.json

# Firebase CLI local cache
.firebase/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Release signing — never commit these
/android/key.properties
*.jks
*.keystore
